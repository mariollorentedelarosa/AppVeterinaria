<Window x:Class="AppPspDsi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppPspDsi"
        mc:Ignorable="d"
        Title="Clínica Veterinaria" Height="700" Width="1050"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Clínica Veterinaria" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Gestión de dueños, mascotas y consultas"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <TabControl Grid.Row="1">


            <TabItem Header="Conexión">
                <Border Style="{StaticResource CardStyle}" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Conexión a la base de datos" Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock Text="Servidor" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtServidor" Text="localhost"/>

                        <TextBlock Text="Usuario" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtUsuario" Text="root"/>

                        <TextBlock Text="Contraseña" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="pwdContrasena"/>

                        <Button x:Name="btnConectar" Content="Conectar" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="btnConectar_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Ellipse x:Name="elpEstadoConexion" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <Label x:Name="lblEstadoConexion" Content="Sin conectar" Padding="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>


            <TabItem Header="Dueños">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Datos del dueño" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="DNI" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtDni"/>

                                <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtNombre"/>

                                <TextBlock Text="Teléfono" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtTelefono"/>

                                <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtEmail"/>

                                <UniformGrid Columns="2" Margin="0,20,0,0">
                                    <Button x:Name="btnInsertarDueno" Content="Insertar" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" Margin="0,0,4,8"/>
                                    <Button x:Name="btnModificarDueno" Content="Modificar"
                                            HorizontalAlignment="Stretch" Margin="4,0,0,8"/>
                                    <Button x:Name="btnEliminarDueno" Content="Eliminar" Style="{StaticResource DangerButtonStyle}"
                                            HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button x:Name="btnLimpiarDueno" Content="Limpiar"
                                            HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>


                    <DataGrid x:Name="dgDuenos" Grid.Column="1" IsReadOnly="True"/>
                </Grid>
            </TabItem>


            <TabItem Header="Mascotas">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Datos de la mascota" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtNombreMascota"/>

                                <TextBlock Text="Especie" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cmbEspecie" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock Text="Dueño" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cmbDueno" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock Text="Fecha de nacimiento" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="dpFechaNacimiento"/>

                                <TextBlock Text="Peso (kg)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtPeso"/>

                                <CheckBox x:Name="chkEsterilizada" Content="Esterilizada" Margin="0,12,0,0"/>

                                <UniformGrid Columns="3" Margin="0,20,0,0">
                                    <Button x:Name="btnInsertarMascota" Content="Insertar" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button x:Name="btnModificarMascota" Content="Modificar"
                                            HorizontalAlignment="Stretch" Margin="4,0,4,0"/>
                                    <Button x:Name="btnEliminarMascota" Content="Eliminar" Style="{StaticResource DangerButtonStyle}"
                                            HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>


                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="dgMascotas" Grid.Row="0" IsReadOnly="True"/>

                        <TextBlock Grid.Row="1" Text="Vacunas de la mascota seleccionada"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8"/>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
                            <ListBox x:Name="lstVacunas" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>


            <TabItem Header="Enviar a App 2">
                <DockPanel Margin="0,16,0,0">


                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MaxWidth="400"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Consulta" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="cmbConsulta" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        <Button x:Name="btnEnviar" Grid.Column="2" Content="Enviar" Width="110" Margin="12,0,0,0"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock DockPanel.Dock="Top" Text="JSON enviado" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox x:Name="txtJsonEnviado" Style="{StaticResource CodeTextBoxStyle}"
                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>

                            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="JSON recibido" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox x:Name="txtJsonRecibido" Style="{StaticResource CodeTextBoxStyle}"
                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Grid>


                        <DockPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Resultados" Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid x:Name="dgResultados" IsReadOnly="True"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
